    { "q": { "en": "How do I check in at the gym?", "ar": "كيف أسجّل دخولي للجيم؟" }, "a": { "en": "Tap the QR button in the middle of the tab bar and show your member card at the entrance scanner or reception.", "ar": "اضغط زر QR في منتصف الشريط السفلي واعرض بطاقتك على جهاز المسح عند المدخل أو للاستقبال." } },
    { "q": { "en": "Can I pay for my membership at the gym?", "ar": "هل يمكنني دفع الاشتراك في الجيم؟" }, "a": { "en": "Yes. Choose 'Pay at the gym' at checkout. Your membership stays pending until reception confirms payment (cash or card).", "ar": "نعم. اختر «الدفع في الجيم» عند الدفع. يبقى الاشتراك قيد الانتظار حتى يؤكد الاستقبال الدفع (نقداً أو بالبطاقة)." } },
    { "q": { "en": "How do rewards tiers work?", "ar": "كيف تعمل مستويات المكافآت؟" }, "a": { "en": "Everyone starts at Bronze for free. Reach Silver, Gold or Platinum with a membership plan or by collecting points.", "ar": "الجميع يبدأ بالبرونزي مجاناً. تصل للفضي أو الذهبي أو البلاتيني باشتراك أو بجمع النقاط." } },
    { "q": { "en": "How do I freeze my membership?", "ar": "كيف أجمّد اشتراكي؟" }, "a": { "en": "Go to My membership › Freeze, pick the dates and confirm. The freeze days are added to your end date.", "ar": "اذهب إلى اشتراكي › تجميد، اختر الأيام وأكّد. تُضاف أيام التجميد إلى تاريخ الانتهاء." } },
    { "q": { "en": "What's the cancellation policy for classes?", "ar": "ما سياسة إلغاء الحصص؟" }, "a": { "en": "Cancel up to 2 hours before a class for free. Late cancellations may lose the booking credit.", "ar": "الإلغاء مجاني حتى ساعتين قبل الحصة. الإلغاء المتأخر قد يُفقدك رصيد الحجز." } },
    { "q": { "en": "Do you have ladies-only hours?", "ar": "هل توجد ساعات خاصة بالسيدات؟" }, "a": { "en": "Yes, daily from 10 AM to 2 PM with female coaches on the floor.", "ar": "نعم، يومياً من ١٠ ص حتى ٢ م مع مدربات في الصالة." } },
    { "q": { "en": "How does online coaching work?", "ar": "كيف يعمل التدريب أونلاين؟" }, "a": { "en": "Your coach builds your plan in the app, checks in weekly and chats with you. Train at home or any gym.", "ar": "يبني مدربك خطتك في التطبيق ويتابعك أسبوعياً ويتواصل معك بالمحادثة. تدرّب في البيت أو أي جيم." } },
    { "q": { "en": "How do I learn to use a machine?", "ar": "كيف أتعلم استخدام جهاز؟" }, "a": { "en": "Open Machines, pick a zone and tap the machine — or scan the QR sticker on the machine itself.", "ar": "افتح الأجهزة، اختر القسم واضغط على الجهاز — أو امسح رمز QR الملصق على الجهاز." } },
    { "q": { "en": "Can I get a refund?", "ar": "هل يمكنني استرداد المبلغ؟" }, "a": { "en": "Memberships can be refunded within 7 days if unused. Shop items can be returned unopened within 14 days.", "ar": "يمكن استرداد الاشتراك خلال ٧ أيام إذا لم يُستخدم. ويمكن إرجاع منتجات المتجر غير المفتوحة خلال ١٤ يوماً." } },
    { "q": { "en": "Is parking available?", "ar": "هل يوجد مواقف سيارات؟" }, "a": { "en": "Free parking in front of Building C201 and on Street 14.", "ar": "مواقف مجانية أمام مبنى C201 وفي الشارع ١٤." } }
  ]
}
